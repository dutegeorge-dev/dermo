---
layout: layouts/base.njk
pagination:
  data: locales
  size: 1
  alias: listLang
permalink: "{{ '/logistika/' | localizedUrl(listLang) }}"
titleKey: logistika.meta.title
descriptionKey: logistika.meta.description
sitemap: true
---
{#
  Экспертная страница «Логистика» (/logistika/).

  ru — версия по ТЗ от 9.10.2026 (удержать мобильный трафик из Директа):
    первый экран с формой (фото погрузки, 4 плашки) → фото с отправок →
    кейсы → блок закупки (/torgovlya/) → способы доставки → с кем работаем →
    цитата → из чего складывается цена → FAQ → контакты → финальный CTA.
    Плюс закреплённая панель «Позвонить / Telegram / Рассчитать» на телефоне
    (поведение — assets/ts/mobile-cta.ts).
  en/zh — прежняя версия страницы, по ТЗ не меняется:
    partials/logistika-legacy.njk.

  Тексты — из i18n-словаря: dict.logistika (см. _data/i18n/ru.ts).
  Шорткод `image` асинхронный, поэтому фото выводятся прямо в шаблоне страницы.
#}
{% if locale != "ru" %}
{% include "partials/logistika-legacy.njk" %}
{% else %}
{% from "partials/icon.njk" import icon %}
{% from "partials/brand-icon.njk" import brandIcon %}
{% from "partials/messengers.njk" import messengers with context %}
{% from "components/cta-band.njk" import ctaBand %}
{% from "components/lead-form-mini.njk" import leadFormMini %}
{% set L = dict.logistika %}
{% set requestUrl = "/kontakty/" | localizedUrl(locale) %}
{% set tradeUrl = "/torgovlya/" | localizedUrl(locale) %}

{% include "partials/header.njk" %}

<main class="flex-1">
  {# Крошки на телефоне скрыты (место первого экрана), на десктопе видны;
     микроразметка BreadcrumbList выводится в обоих случаях. #}
  <div class="hidden md:block">{% include "partials/breadcrumbs.njk" %}</div>

  {# ── 1. Первый экран: фото погрузки под затемнением + форма ─────────────
     Фон — кадр из «Фото с наших отправок», грузится сразу (eager): это LCP.
     Затемнение brand-dark/70 даёт контраст белого текста ≥ 5,1:1 даже поверх
     чисто белого участка фото (норма — 4,5:1). На десктопе к правому краю
     светлее: там белая карточка формы, а текст — в левой половине (≥ 70%). #}
  <section class="relative isolate overflow-hidden bg-brand-dark text-white">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      {% image "/assets/img/uploads/otpravki-4-3x4.jpg", "", "100vw", "h-full w-full object-cover object-[center_65%]", "eager" %}
      <div class="absolute inset-0 bg-brand-dark/70 lg:bg-transparent lg:bg-gradient-to-r lg:from-brand-dark/75 lg:via-brand-dark/70 lg:to-brand-dark/45"></div>
    </div>
    <div class="container grid items-center gap-5 pb-10 pt-5 md:gap-10 md:py-16 lg:grid-cols-2 lg:gap-16 lg:py-20">
      {# Левая колонка: H1, подзаголовок, плашки, мессенджеры #}
      <div>
        <h1 class="max-w-2xl text-[1.75rem] font-light leading-tight tracking-tight sm:text-4xl md:text-5xl">{{ L.hero.h1 }}</h1>
        <p class="mt-3 max-w-xl text-base leading-snug text-white md:mt-6 md:text-xl md:font-light md:leading-relaxed">{{ L.hero.subtitle }}</p>
        {# Плашки: телефон — 2×2, десктоп — одна строка. #}
        <ul class="mt-4 grid grid-cols-2 gap-2 md:mt-8 md:grid-cols-4 md:gap-3">
          {% for b in L.hero.badges %}
            <li class="flex items-center gap-2 rounded-lg border border-white/25 bg-white/10 px-2.5 py-2 text-[0.8125rem] font-medium leading-tight text-white md:flex-col md:items-start md:gap-2.5 md:p-3">
              {{ icon(b.icon, "h-4 w-4 shrink-0 text-cyan md:h-5 md:w-5") }}
              <span>{{ b.text }}</span>
            </li>
          {% endfor %}
        </ul>
        {# Мессенджеры: на телефоне идут под формой (см. ниже), чтобы верх
           формы помещался в первый экран; здесь — с планшета. #}
        <div class="mt-8 hidden flex-row flex-wrap gap-3 md:flex">
          {{ messengers("lg", "ring-offset-brand") }}
        </div>
      </div>
      {# Правая колонка: мини-форма расчёта (единый компонент с главной).
         id — якорь кнопки «Рассчитать» в панели на телефоне. #}
      <div id="raschet" class="scroll-mt-24" data-mobile-cta-start>
        {{ leadFormMini(locale, "logi") }}
      </div>
      <div class="flex gap-3 md:hidden">
        {{ messengers("lg", "ring-offset-brand", grow=true) }}
      </div>
    </div>
  </section>

  {# ── 2. Фото с наших отправок ────────────────────────────────────────────
     Телефон — горизонтальная лента со scroll-snap (одно фото целиком + край
     следующего, без автопрокрутки), с md — сетка. Подпись — текст alt.
     Тап открывает фото на весь экран (лайтбокс, assets/ts/gallery.ts).
     Первые два кадра попадают на второй экран — грузятся без lazy. #}
  <section id="otpravki" class="scroll-mt-24 bg-surface">
    <div class="container section">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-light tracking-tight text-ink md:text-4xl">{{ "gallery.title" | t(locale) }}</h2>
        <p class="mt-3 text-base leading-relaxed text-muted md:text-lg">{{ "gallery.lead" | t(locale) }}</p>
      </div>
      <ul data-gallery class="snap-strip mt-6 md:mt-8 md:grid md:grid-cols-3 md:gap-4 lg:grid-cols-6">
        {% for n in range(1, 7) %}
          {% set alt = ("gallery.alt" + n) | t(locale) %}
          <li class="snap-strip-item md:w-auto">
            <figure>
              <button
                type="button"
                data-gallery-item
                class="group block w-full overflow-hidden rounded-xl border border-slate-200 bg-surface-alt focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan focus-visible:ring-offset-2"
                aria-label="{{ alt }} — {{ 'gallery.zoom' | t(locale) }}"
              >
                {% image "/assets/img/uploads/otpravki-" + n + "-3x4.jpg", alt, "(min-width: 1024px) 12rem, (min-width: 768px) 30vw, 78vw", "aspect-[3/4] w-full object-cover transition-transform duration-300 group-hover:scale-105", ("eager" if n <= 2 else "lazy") %}
              </button>
              <figcaption class="mt-2 text-sm leading-snug text-muted">{{ alt }}</figcaption>
            </figure>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  {# ── 3. Кейсы ────────────────────────────────────────────────────────────
     Карточка: фото, заголовок и одна строка результата (L.caseResults по
     адресу кейса). Длинное описание — на странице кейса. Телефон — лента,
     с md — сетка в три колонки. #}
  {% set libItems = library.kejsy[locale] %}
  {% set caseItems = libItems if (libItems and libItems.length) else homeCases %}
  <section id="kejsy" class="scroll-mt-24 bg-surface-alt">
    <div class="container section">
      <div class="flex items-end justify-between gap-4">
        <h2 class="text-3xl font-light tracking-tight text-ink md:text-4xl">{{ "home.cases.title" | t(locale) }}</h2>
        <a href="{{ '/kejsy/' | localizedUrl(locale) }}" class="inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-cyan-dark transition-colors hover:text-cyan">
          {{ "home.cases.all" | t(locale) }}
          {{ icon("arrow-right", "h-4 w-4") }}
        </a>
      </div>
      <ul class="snap-strip mt-6 md:mt-8 md:grid md:grid-cols-3 md:gap-6">
        {% for item in caseItems %}
          {% if loop.index0 < 3 %}
            {% set result = L.caseResults[item.url] or item.result %}
            <li class="snap-strip-item md:w-auto">
              <a
                href="{{ item.url }}"
                class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-surface shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan"
              >
                {% if item.cover %}
                  {% image item.cover, item.alt or item.title, "(min-width: 1024px) 360px, (min-width: 768px) 30vw, 78vw", "aspect-[16/10] w-full object-cover" %}
                {% else %}
                  <span class="flex aspect-[16/10] w-full items-center justify-center bg-surface-alt" aria-hidden="true">
                    {{ icon("package", "h-10 w-10 text-slate-300") }}
                  </span>
                {% endif %}
                <div class="flex flex-1 flex-col p-5 md:p-6">
                  <h3 class="text-base font-medium leading-snug text-ink md:text-lg">{{ item.title }}</h3>
                  {% if result %}
                    <p class="mt-3 flex items-start gap-2 text-sm font-semibold text-cyan-dark">
                      {{ icon("check", "mt-0.5 h-4 w-4 shrink-0") }}<span>{{ result }}</span>
                    </p>
                  {% endif %}
                  <span class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-medium text-cyan-dark transition-colors group-hover:text-cyan">
                    {{ "home.cases.more" | t(locale) }}
                    {{ icon("arrow-right", "h-4 w-4") }}
                  </span>
                </div>
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </section>

  {# ── 4. Нет команды в Китае? Подключим свою → /torgovlya/ ────────────────
     Поднят сразу после кейсов: запросы о закупке — заметная часть рекламы.
     Три фото — лентой на телефоне, сеткой с md. Слоты в Decap («Логистика»):
     logistika-komanda-<1..3>-4x3. Пока они пустые, выводится прежнее одно
     фото блока (logistika-komanda-16x9). #}
  <section id="torgovlya" class="scroll-mt-24 bg-surface">
    <div class="container section">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-cyan/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-cyan-dark">
          {{ icon("search", "h-3.5 w-3.5") }}{{ "mega.trade.title" | t(locale) }}
        </span>
        <h2 class="mt-4 text-2xl font-semibold tracking-tight md:text-3xl">{{ L.trade.title }}</h2>
        <p class="mt-5 text-base text-muted">{{ L.trade.intro1 }}</p>
        <p class="mt-4 text-base text-muted">{{ L.trade.intro2 }}</p>
      </div>

      {% set tradePhotos = [] %}
      {% for n in range(1, 4) %}
        {% set src = "/assets/img/uploads/logistika-komanda-" + n + "-4x3.jpg" %}
        {% if src | photoExists %}{% set _ = tradePhotos.push({ src: src, alt: L.trade.photoAlts[n - 1] }) %}{% endif %}
      {% endfor %}
      {% if tradePhotos.length %}
        <ul class="snap-strip mt-8 md:grid md:grid-cols-3 md:gap-5">
          {% for ph in tradePhotos %}
            <li class="snap-strip-item md:w-auto">
              <div class="aspect-[4/3] overflow-hidden rounded-xl border border-slate-200 bg-surface-alt">
                {% image ph.src, ph.alt, "(min-width: 768px) 24rem, 78vw", "h-full w-full object-cover" %}
              </div>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        {# Пока три фото не загружены — прежнее одно фото (коллаж) блока. #}
        <div class="relative mt-8 aspect-[16/9] max-w-3xl overflow-hidden rounded-2xl border border-slate-200 bg-surface-alt">
          {% image "/assets/img/uploads/logistika-komanda-16x9.jpg", L.trade.title, "(min-width: 768px) 48rem, 90vw", "relative h-full w-full object-cover" %}
        </div>
      {% endif %}

      <div class="mt-8">
        <a href="{{ tradeUrl }}" class="btn-accent w-full px-6 py-3 text-base sm:w-auto">
          {{ L.trade.cta }}
          {{ icon("arrow-right", "ml-1.5 h-5 w-5") }}
        </a>
      </div>
    </div>
  </section>

  {# ── 5. Способы доставки — компактные карточки без картинок ──────────────
     Иконка, название, срок, одна строка, «Подробнее». Телефон — 2×2,
     десктоп — один ряд. #}
  <section id="sposoby" class="scroll-mt-24 bg-surface-alt">
    <div class="container section">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">{{ L.methods.title }}</h2>
      <div class="mt-6 grid grid-cols-2 gap-3 md:mt-8 md:gap-4 lg:grid-cols-4">
        {% for m in L.methods.items %}
          <a href="{{ m.url | localizedUrl(locale) }}" class="group flex flex-col rounded-xl border border-slate-200 bg-white p-4 transition-colors hover:border-cyan md:p-6">
            {{ icon(m.icon, "h-7 w-7 text-cyan md:h-8 md:w-8") }}
            <h3 class="mt-3 text-sm font-semibold leading-snug text-ink md:mt-4 md:text-base">{{ m.title }}</h3>
            <p class="mt-1.5 text-lg font-semibold text-cyan md:mt-2 md:text-2xl">{{ m.time }}</p>
            <p class="mt-1.5 flex-1 text-xs leading-snug text-muted md:mt-2 md:text-sm">{{ m.desc }}</p>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-cyan-dark md:mt-4">
              {{ "home.cases.more" | t(locale) }}
              {{ icon("arrow-right", "h-4 w-4 transition-transform group-hover:translate-x-1") }}
            </span>
          </a>
        {% endfor %}
      </div>
      <p class="mt-5 flex items-center gap-2 text-sm font-medium text-muted">
        {{ icon("package", "h-4 w-4 shrink-0 text-cyan") }}
        {{ L.methods.note }}
      </p>
    </div>
  </section>

  {# ── 6. С кем мы работаем ─────────────────────────────────────────────── #}
  <section id="dlya-kogo" class="container section scroll-mt-24">
    <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">{{ L.audience.title }}</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-3">
      {% for a in L.audience.items %}
        <div class="flex flex-col rounded-xl border border-slate-200 bg-white p-6">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-cyan/10">
            {{ icon(a.icon, "h-6 w-6 text-cyan") }}
          </span>
          <h3 class="mt-4 text-base font-semibold text-ink">{{ a.title }}</h3>
          {# desc категорий содержит перелинковку на /tovary/* — рендерим как safe. #}
          <p class="mt-2 text-sm text-muted">{{ a.desc | safe }}</p>
        </div>
      {% endfor %}
    </div>
  </section>

  {# ── 7. Цитата руководителя ───────────────────────────────────────────── #}
  <section class="bg-brand text-white">
    <div class="container section">
      <div class="grid items-center gap-8 md:grid-cols-3">
        <div class="md:col-span-1">
          {# Фото руководителя — заглушка 1:1 (заменяется через Decap:
             logistika-rukovoditel-1x1.jpg). #}
          <div class="mx-auto w-48 max-w-full overflow-hidden rounded-2xl border border-white/20 md:w-full">
            {% image "/assets/img/uploads/logistika-rukovoditel-1x1.jpg", L.quote.photoAlt, "(min-width: 768px) 22rem, 12rem", "aspect-square w-full object-cover" %}
          </div>
        </div>
        <figure class="md:col-span-2">
          <blockquote class="text-lg font-light leading-relaxed text-white/95 md:text-xl">
            «{{ L.quote.text }}»
          </blockquote>
          <figcaption class="mt-5 text-sm text-white/80">
            <span class="font-semibold text-white">{{ L.quote.author }}</span>, {{ L.quote.role }}
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  {# ── 8. Из чего складывается цена (+ строка о договоре комиссии) ──────── #}
  <section id="stoimost" class="scroll-mt-24 bg-surface-alt">
    <div class="container section">
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">{{ L.cost.structureTitle }}</h2>
      {# items-stretch: карточка и фото одной высоты, без «ступеньки» под списком. #}
      <div class="mt-8 grid items-stretch gap-8 lg:grid-cols-2">
        <div class="rounded-xl border border-slate-200 bg-white p-6">
          <ul class="space-y-3">
            {% for c in L.cost.structure %}
              <li class="flex items-start gap-3">
                {{ icon(c.icon, "mt-0.5 h-5 w-5 shrink-0 text-cyan") }}
                <span class="text-sm text-ink">{{ c.text }}</span>
              </li>
            {% endfor %}
          </ul>
          <p class="mt-5 flex items-start gap-3 border-t border-slate-200 pt-5 text-sm font-medium text-ink">
            {{ icon("receipt", "mt-0.5 h-5 w-5 shrink-0 text-cyan") }}
            <span>{{ L.cost.contractNote }}</span>
          </p>
        </div>
        {# Фото с поставки — слот под загрузку (Decap: «Логистика»). #}
        <div class="relative min-h-[15rem] overflow-hidden rounded-xl border border-slate-200 bg-surface-alt">
          <span class="absolute inset-0 flex items-center justify-center">{{ icon("camera", "h-8 w-8 text-slate-300") }}</span>
          {% image "/assets/img/uploads/logistika-postavka-4x3.jpg", L.cost.structureTitle, "(min-width: 1024px) 34rem, 90vw", "relative h-full w-full object-cover" %}
        </div>
      </div>
    </div>
  </section>

  {# ── 9. FAQ (аккордеон + микроразметка FAQPage) ───────────────────────── #}
  <section id="faq" class="scroll-mt-24">
    <div class="container section">
      <div class="container-narrow !px-0">
        <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">{{ L.faq.title }}</h2>
        <div class="mt-8 rounded-xl border border-slate-200 bg-white px-5 sm:px-6">
          {% for item in L.faq.items %}
            <div class="border-b border-slate-200 last:border-b-0">
              <button
                type="button"
                data-accordion-toggle
                class="flex w-full items-center justify-between gap-4 py-4 text-left text-base font-medium text-ink"
                aria-expanded="false"
                aria-controls="faq-panel-{{ loop.index }}"
              >
                <span>{{ item.q }}</span>
                {{ icon("chevron-down", "accordion-caret h-5 w-5 shrink-0 text-cyan transition-transform duration-200") }}
              </button>
              <div id="faq-panel-{{ loop.index }}" data-accordion-panel class="hidden pb-4" hidden>
                {# ответ может содержать перелинковку (<a>) и список — рендерим как safe. #}
                <div class="max-w-2xl text-sm text-muted">{{ item.a | safe }}</div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  {# ── 10. Как с нами связаться (панель на телефоне здесь прячется) ─────── #}
  <section id="kontakty-blok" class="scroll-mt-24 bg-surface-alt" data-mobile-cta-stop>
    <div class="container section">
      <div class="container-narrow !px-0">
        <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">{{ L.contacts.title }}</h2>
        <p class="mt-4 text-base text-muted">{{ L.contacts.text }}</p>
        {# 1-я строка — телефон и e-mail, 2-я — кнопки мессенджеров (разные сервисы). #}
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <a href="tel:{{ site.phoneHref }}" class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 transition-colors hover:border-cyan">
            {{ icon("phone", "h-5 w-5 shrink-0 text-cyan") }}
            <span>
              <span class="block text-xs text-muted">{{ L.contacts.phoneRuLabel }}</span>
              <span class="block font-semibold text-ink">{{ site.phone }}</span>
            </span>
          </a>
          <a href="mailto:{{ site.email }}" class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 transition-colors hover:border-cyan">
            {{ icon("mail", "h-5 w-5 shrink-0 text-cyan") }}
            <span>
              <span class="block text-xs text-muted">{{ L.contacts.emailLabel }}</span>
              <span class="block font-semibold text-ink">{{ site.email }}</span>
            </span>
          </a>
        </div>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {{ messengers("lg") }}
        </div>
      </div>
    </div>
  </section>

  {# ── 11. Финальный CTA ────────────────────────────────────────────────── #}
  <div data-mobile-cta-stop>
    {{ ctaBand(L.finalCta.button, requestUrl, text=L.finalCta.subtitle, title=L.finalCta.title, tone="final") }}
  </div>

</main>

{# Микроразметка FAQPage (Schema.org) — для расширенных сниппетов в поиске. #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for item in L.faq.items %}
    {
      "@type": "Question",
      "name": {{ item.q | dump | safe }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ item.a | striptags | dump | safe }}
      }
    }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>

{% include "partials/footer.njk" %}

{# ── Закреплённая панель на телефоне (до 768 px) ─────────────────────────
   Появляется, когда форма первого экрана ушла за верхний край; прячется у
   блока контактов и финального CTA (data-mobile-cta-stop). Логика —
   assets/ts/mobile-cta.ts. «Позвонить» и «Telegram» — обычные ссылки, чтобы
   Метрика сама засчитала автоцели «Клик по номеру» и «Переход в мессенджер».
