---
layout: layouts/reading.njk
service: poisk-postavshchika
titleKey: uslugi.torgovlya.poisk.metaTitle
descriptionKey: uslugi.torgovlya.poisk.metaDescription
showTitle: false
---
{#
  Эталонная страница торговой услуги «Поиск поставщика»
  (/uslugi/torgovlya/poisk-postavshchika/) на читательском шаблоне.

  Каркас (reading.njk): хлебные крошки → hero (service-hero) → колонка контента
  с правым sticky-оглавлением → перелинковка (service-related) → финальный CTA
  (service-cta). Здесь — 7 разделов контента (они формируют оглавление и
  scroll-spy). Тексты — из i18n (ветка uslugi.torgovlya.poisk), берём через
  локаль-резолвленный `dict`. Структура/ссылки — в _data/services.ts.

  По образцу этой страницы делаются остальные торговые услуги.
#}
{% from "components/photo-placeholder.njk" import photoPlaceholder %}
{% set P = dict.uslugi.torgovlya.poisk %}

{# Раздел 1 — Что это за услуга. #}
<section id="chto-eto" class="scroll-mt-28">
  <h2>{{ P.chtoEto.title }}</h2>
  {% if P.chtoEto.subtitle %}<h3>{{ P.chtoEto.subtitle }}</h3>{% endif %}
  {% for para in P.chtoEto.paragraphs %}
    <p>{{ para }}</p>
  {% endfor %}
</section>

{# Раздел 2 — Зачем это нужно (боли импортёра). #}
<section id="zachem" class="scroll-mt-28">
  <h2>{{ P.zachem.title }}</h2>
  {% if P.zachem.subtitle %}<h3>{{ P.zachem.subtitle }}</h3>{% endif %}
  <p>{{ P.zachem.intro }}</p>
  <ul>
    {% for pain in P.zachem.pains %}
      <li><strong>{{ pain.lead }}</strong> {{ pain.text }}</li>
    {% endfor %}
  </ul>
  <p>{{ P.zachem.closing }}</p>
</section>

{# Раздел 3 — Кому подходит (опц., есть не у каждой услуги). #}
{% if P.komuPodhodit %}
<section id="komu-podhodit" class="scroll-mt-28">
  <h2>{{ P.komuPodhodit.title }}</h2>
  <p>{{ P.komuPodhodit.text }}</p>
  <ul>
    {% for cat in P.komuPodhodit.categories %}
      <li>{{ cat }}</li>
    {% endfor %}
  </ul>
  <p>{{ P.komuPodhodit.note }}</p>
</section>
{% endif %}

{# Раздел 4 — Как мы это делаем (этапы + место под фото). #}
<section id="kak-delaem" class="scroll-mt-28">
  <h2>{{ P.kakDelaem.title }}</h2>
  {% if P.kakDelaem.subtitle %}<h3>{{ P.kakDelaem.subtitle }}</h3>{% endif %}
  <ol>
    {% for step in P.kakDelaem.steps %}
      <li>
        <strong>{{ step.title }}.</strong> {{ step.text }}
        {% if step.items %}
          <ul>
            {% for sub in step.items %}<li>{{ sub }}</li>{% endfor %}
          </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ol>
  {% if P.kakDelaem.photoCaption %}{{ photoPlaceholder(P.kakDelaem.photoCaption, "light") }}{% endif %}
</section>

{# Раздел 5 — Сравнение «Сам / Агент / БАРС» (опц., визуальная таблица). #}
{% if P.sravnenie %}
<section id="sravnenie" class="scroll-mt-28">
  <h2>{{ P.sravnenie.title }}</h2>
  <div class="mt-5 overflow-x-auto">
    <table class="w-full min-w-[36rem] border-collapse text-left text-sm">
      <thead>
        <tr class="border-b border-slate-200">
          <th class="py-3 pr-4 font-semibold text-ink"></th>
          <th class="px-4 py-3 font-medium text-muted">{{ P.sravnenie.columns.self }}</th>
          <th class="px-4 py-3 font-medium text-muted">{{ P.sravnenie.columns.agent }}</th>
          <th class="rounded-t-lg bg-cyan/10 px-4 py-3 font-semibold text-cyan-dark">{{ P.sravnenie.columns.bars }}</th>
        </tr>
      </thead>
      <tbody>
        {% for row in P.sravnenie.rows %}
        <tr class="border-b border-slate-200 align-top last:border-b-0">
          <td class="py-3 pr-4 font-medium text-ink">{{ row.criterion }}</td>
          <td class="px-4 py-3 text-muted">{{ row.self }}</td>
          <td class="px-4 py-3 text-muted">{{ row.agent }}</td>
          <td class="bg-cyan/5 px-4 py-3 font-medium text-ink">{{ row.bars }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}

{# Раздел 6 — Что вы получаете (результат). #}
<section id="chto-poluchaete" class="scroll-mt-28">
  <h2>{{ P.chtoPoluchaete.title }}</h2>
  {% if P.chtoPoluchaete.subtitle %}<h3>{{ P.chtoPoluchaete.subtitle }}</h3>{% endif %}
  <ul>
    {% for item in P.chtoPoluchaete.items %}
      <li>{{ item }}</li>
    {% endfor %}
  </ul>
  {% if P.chtoPoluchaete.closing %}<p>{{ P.chtoPoluchaete.closing }}</p>{% endif %}
</section>

{# Раздел 7 — FAQ-аккордеон (внутри колонки, чтобы попасть в оглавление) +
   микроразметка FAQPage. Аккордеон — общий (data-accordion-*, см. header.ts). #}
<section id="faq" class="scroll-mt-28">
  <h2>{{ P.faqTitle }}</h2>
  <div class="mt-6 rounded-xl border border-slate-200 bg-white px-5 sm:px-6">
    {% for item in P.faq %}
      <div class="border-b border-slate-200 last:border-b-0">
        <button
          type="button"
          data-accordion-toggle
          class="flex w-full items-center justify-between gap-4 py-4 text-left text-base font-medium text-ink"
          aria-expanded="false"
          aria-controls="faq-panel-{{ loop.index }}"
        >
          <span>{{ item.q }}</span>
          {% from "partials/icon.njk" import icon %}
          {{ icon("chevron-down", "accordion-caret h-5 w-5 shrink-0 text-cyan transition-transform duration-200") }}
        </button>
        <div id="faq-panel-{{ loop.index }}" data-accordion-panel class="hidden pb-4" hidden>
          <p class="text-sm leading-relaxed text-muted">{{ item.a }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{# JSON-LD: FAQPage (частые вопросы) + Service (тип услуги для поисковиков). #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for item in P.faq %}
    {
      "@type": "Question",
      "name": {{ item.q | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} }
    }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": {{ P.hero.title | dump | safe }},
  "serviceType": {{ P.hero.title | dump | safe }},
  "description": {{ P.metaDescription | dump | safe }},
  "url": {{ (site.url + page.url) | dump | safe }},
  "areaServed": "RU",
  "provider": {
    "@type": "Organization",
    "name": {{ site.legalName | dump | safe }},
    "url": {{ site.url | dump | safe }}
  }
}
</script>
