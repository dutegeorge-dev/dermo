---
layout: layouts/reading.njk
service: upakovka-markirovka
titleKey: uslugi.torgovlya.upakovka.metaTitle
descriptionKey: uslugi.torgovlya.upakovka.metaDescription
showTitle: false
---
{#
  Страница торговой услуги «Упаковка и маркировка»
  (/uslugi/torgovlya/upakovka-markirovka/) на читательском шаблоне. Порядок:
  что это → зачем → как делаем → оговорка по «Честному знаку» → что получаете → FAQ.
  Тексты — i18n (uslugi.torgovlya.upakovka).
#}
{% set P = dict.uslugi.torgovlya.upakovka %}

{# Раздел 1 — Что это за услуга. #}
<section id="chto-eto" class="scroll-mt-28">
  <h2>{{ P.chtoEto.title }}</h2>
  {% for para in P.chtoEto.paragraphs %}<p>{{ para }}</p>{% endfor %}
</section>

{# Раздел 2 — Зачем это нужно (боли + вывод-акцент). #}
<section id="zachem" class="scroll-mt-28">
  <h2>{{ P.zachem.title }}</h2>
  <p>{{ P.zachem.intro }}</p>
  <ul>
    {% for pain in P.zachem.pains %}<li><strong>{{ pain.lead }}</strong> {{ pain.text }}</li>{% endfor %}
  </ul>
  <p class="reading-takeaway">{{ P.zachem.closing }}</p>
</section>

{# Раздел 3 — Как мы это делаем (5 шагов + фото). #}
<section id="kak-delaem" class="scroll-mt-28">
  <h2>{{ P.kakDelaem.title }}</h2>
  <ol>
    {% for step in P.kakDelaem.steps %}<li><strong>{{ step.title }}.</strong> {{ step.text }}</li>{% endfor %}
  </ol>
  {# TODO(owner): фото процесса услуги временно скрыто (оставлен только hero). Вернуть — убрать `false and` из условия ниже. #}
  {% if false and P.kakDelaem.photoCaption %}<figure class="my-2 overflow-hidden rounded-xl border border-slate-200">{% image "/assets/img/uploads/usluga-" + service + "-process-16x9.jpg", P.kakDelaem.photoCaption, "(min-width: 1024px) 45rem, 90vw", "w-full" %}</figure>{% endif %}
</section>

{# Раздел 4 — Важная оговорка по «Честному знаку» (интро + вывод-акцент). #}
<section id="chestnyy-znak" class="scroll-mt-28">
  <h2>{{ P.chestnyyZnak.title }}</h2>
  <p>{{ P.chestnyyZnak.intro }}</p>
  <p class="reading-takeaway">{{ P.chestnyyZnak.closing | safe }}</p>
</section>

{# Раздел 5 — Что вы получаете. #}
<section id="chto-poluchaete" class="scroll-mt-28">
  <h2>{{ P.chtoPoluchaete.title }}</h2>
  <ul>
    {% for item in P.chtoPoluchaete.items %}<li>{{ item }}</li>{% endfor %}
  </ul>
</section>

{# Раздел 6 — FAQ-аккордеон (в оглавление) + FAQPage. #}
<section id="faq" class="scroll-mt-28">
  <h2>{{ P.faqTitle }}</h2>
  <div class="mt-6 rounded-xl border border-slate-200 bg-white px-5 sm:px-6">
    {% for item in P.faq %}
      <div class="border-b border-slate-200 last:border-b-0">
        <button
          type="button"
          data-accordion-toggle
          class="flex w-full items-center justify-between gap-4 py-4 text-left text-base font-medium text-ink"
          aria-expanded="false"
          aria-controls="faq-panel-{{ loop.index }}"
        >
          <span>{{ item.q }}</span>
          {% from "partials/icon.njk" import icon %}
          {{ icon("chevron-down", "accordion-caret h-5 w-5 shrink-0 text-cyan transition-transform duration-200") }}
        </button>
        <div id="faq-panel-{{ loop.index }}" data-accordion-panel class="hidden pb-4" hidden>
          <p class="text-sm leading-relaxed text-muted">{{ item.a }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{# JSON-LD: FAQPage + Service. #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for item in P.faq %}
    { "@type": "Question", "name": {{ item.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} } }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": {{ P.hero.title | dump | safe }},
  "serviceType": {{ P.hero.title | dump | safe }},
  "description": {{ P.metaDescription | dump | safe }},
  "url": {{ (site.url + page.url) | dump | safe }},
  "areaServed": "RU",
  "provider": { "@type": "Organization", "name": {{ site.legalName | dump | safe }}, "url": {{ site.url | dump | safe }} }
}
</script>
