{# Список городов (шаблонный). Карточки строятся из _data/uslugi.ts. #}
{% from "partials/icon.njk" import icon %}

<p class="mt-2 max-w-2xl text-base leading-relaxed text-muted">{{ "uslugi.gorodaList.subtitle" | t(locale) }}</p>

<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {% for c in uslugi.goroda %}
    <a href="{{ c.url | localizedUrl(locale) }}" class="group flex items-center gap-4 rounded-xl border border-slate-200 bg-white p-5 transition-colors hover:border-cyan">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-cyan/10">
        {{ icon(c.icon, "h-6 w-6 text-cyan") }}
      </span>
      <span class="flex-1 text-base font-semibold text-ink">{{ c.nameKey | t(locale) }}</span>
      {{ icon("arrow-right", "h-5 w-5 shrink-0 text-cyan transition-transform group-hover:translate-x-1") }}
    </a>
  {% endfor %}
</div>
