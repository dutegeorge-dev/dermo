---
# Витрина блога — по одной локализованной странице на язык: /blog/, /en/blog/,
# /zh/blog/. Карточки берутся из контентной библиотеки (новые сверху, без
# черновиков); фолбэк-версии (без перевода) показываются на русском.
pagination:
  data: locales
  size: 1
  alias: listLang
  addAllPagesToCollections: true
permalink: "{{ '/blog/' | localizedUrl(listLang) }}"
sitemap: true
eleventyComputed:
  title: "{{ 'content.blogTitle' | t(listLang) }}"
  description: "{{ 'content.blogLead' | t(listLang) }}"
---
{% set items = library.blog[listLang] %}
{% set listKind = "blog" %}
{% set placeholderIcon = "file-text" %}
{% set emptyText = "content.emptyBlog" | t(listLang) %}
<p class="mt-2 max-w-2xl text-muted">{{ "content.blogLead" | t(listLang) }}</p>
{% include "components/content-list.njk" %}
