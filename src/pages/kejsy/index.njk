---
# Витрина кейсов — по одной локализованной странице на язык: /kejsy/, /en/kejsy/,
# /zh/kejsy/. Карточки из контентной библиотеки (новые сверху, без черновиков),
# показывают итог-result, если он задан; фолбэк-версии — на русском.
pagination:
  data: locales
  size: 1
  alias: listLang
  addAllPagesToCollections: true
permalink: "{{ '/kejsy/' | localizedUrl(listLang) }}"
sitemap: true
eleventyComputed:
  title: "{{ 'content.casesTitle' | t(listLang) }}"
  description: "{{ 'content.casesLead' | t(listLang) }}"
---
{% set items = library.kejsy[listLang] %}
{% set listKind = "kejsy" %}
{% set placeholderIcon = "package" %}
{% set emptyText = "content.emptyCases" | t(listLang) %}
<p class="mt-2 max-w-2xl text-muted">{{ "content.casesLead" | t(listLang) }}</p>
{% include "components/content-list.njk" %}
