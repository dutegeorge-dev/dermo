---
layout: layouts/base.njk
---
{#
  Читательский шаблон — единый каркас для нелендингового («читательского»)
  сегмента сайта: страницы услуг, кейсы, статьи блога, политика и прочие
  текстовые страницы. Флагманские лендинги (главная, /logistika/, /torgovlya/)
  этот шаблон НЕ используют.

  Структура:
    хлебные крошки (на синем) → [опц. hero] → колонка контента ограниченной
    ширины + правое sticky-оглавление (scroll-spy на TS, см. assets/ts/toc.ts) →
    [опц. продающие модули: перелинковка, FAQ, CTA].

  Оглавление строится автоматически из разделов контента (section[id]) и
  показывается только при 3+ разделах (порог в toc.ts). На мобайле — блок
  «Содержание» сверху (аккордеон). Контент размечается как <section id="…">
  с заголовком h2 — этого достаточно, чтобы попасть в оглавление.

  Опциональные продающие модули (подключаются данными страницы, всё опц.):
    service       — слаг услуги (services.ts): hero + перелинковка + финальный
                    CTA торговой услуги (см. components/service-*.njk);
    heroInclude   — путь include с hero (напр. "components/hero.njk");
    relatedLinks  — [{ label, url, icon }] → блок перелинковки;
    relatedTitle  — заголовок блока перелинковки;
    faqItems      — [{ q, a }] → FAQ-аккордеон + FAQPage;
    faqTitle      — заголовок FAQ;
    ctaFinal      — true → финальная CTA-полоса (components/cta-final.njk).

  FAQ страницы услуги — это раздел контента (section#faq внутри колонки), чтобы
  попасть в оглавление; обрамление (hero/перелинковка/CTA) в оглавление не входит.
#}
{% from "components/faq.njk" import faq %}
{% from "components/related.njk" import related %}
{% if service %}{% set svc = services[service] %}{% endif %}
{% if city %}{% set cityData = goroda[city] %}{% endif %}

{% include "partials/header.njk" %}

<main class="flex-1">
  {% include "partials/breadcrumbs.njk" %}

  {# Hero над контентом, во всю ширину: услуга (svc), город (cityData) или include.
     Hero услуги/города заинлайнен (не include): внутри — async-шорткод `image`,
     который НЕ исполняется в include, вызванном из layout (рендерится пустым),
     но корректно работает в самом layout. Фото — заглушки 4:3 в uploads. #}
  {% from "partials/icon.njk" import icon %}
  {% if svc %}
  <section class="bg-brand text-white">
    <div class="container grid items-center gap-10 py-14 md:py-16 lg:grid-cols-2 lg:gap-16">
      <div>
        <h1 class="max-w-2xl text-4xl font-light leading-tight tracking-tight md:text-5xl">
          {{ (svc.i18nBase + ".hero.title") | t(locale) }}
        </h1>
        <p class="mt-6 max-w-xl text-lg font-light leading-relaxed text-white/85">
          {{ (svc.i18nBase + ".hero.subtitle") | t(locale) }}
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href="{{ svc.requestUrl | localizedUrl(locale) }}"
            class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-lg bg-accent px-6 py-3 text-base font-medium text-white transition-colors hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-brand"
          >
            {{ "cta.request" | t(locale) }}
          </a>
          <a
            href="{{ site.telegram }}"
            rel="nofollow noopener"
            target="_blank"
            class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-lg bg-telegram px-6 py-3 text-base font-medium text-white transition-colors hover:bg-telegram-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-telegram focus-visible:ring-offset-2 focus-visible:ring-offset-brand"
          >
            {{ icon("send", "h-5 w-5") }}
            {{ "cta.telegramWrite" | t(locale) }}
          </a>
        </div>
      </div>

      {# Фото услуги — заглушка 4:3 (заменяется через Decap: usluga-<слаг>-hero-4x3.jpg). #}
      <div class="hidden lg:block">
        <figure class="overflow-hidden rounded-2xl ring-1 ring-inset ring-white/15">
          {% image "/assets/img/uploads/usluga-" + service + "-hero-4x3.jpg", (svc.i18nBase + ".hero.photoCaption") | t(locale), "(min-width: 1024px) 33rem, 90vw", "w-full" %}
        </figure>
      </div>
    </div>
  </section>
  {% elif cityData %}
  <section class="bg-brand text-white">
    <div class="container grid items-center gap-10 py-14 md:py-16 lg:grid-cols-2 lg:gap-16">
      <div>
        <h1 class="max-w-2xl text-4xl font-light leading-tight tracking-tight md:text-5xl">
          Доставка из Китая в {{ cityData.acc }}
        </h1>
        <p class="mt-6 max-w-xl text-lg font-light leading-relaxed text-white/85">
          Привезём ваш груз из Китая до склада в {{ cityData.prep }} — в белую, со стыковкой доставки и таможенного оформления.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href="{{ '/kontakty/' | localizedUrl(locale) }}"
            class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-lg bg-accent px-6 py-3 text-base font-medium text-white transition-colors hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-brand"
          >
            {{ "cta.request" | t(locale) }}
          </a>
          <a
            href="{{ site.telegram }}"
            rel="nofollow noopener"
            target="_blank"
            class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-lg bg-telegram px-6 py-3 text-base font-medium text-white transition-colors hover:bg-telegram-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-telegram focus-visible:ring-offset-2 focus-visible:ring-offset-brand"
          >
            {{ icon("send", "h-5 w-5") }}
            {{ "cta.telegramWrite" | t(locale) }}
          </a>
        </div>
      </div>

      {# Фото города — заглушка 4:3 (заменяется через Decap: gorod-<слаг>-hero-4x3.jpg). #}
      <div class="hidden lg:block">
        <figure class="overflow-hidden rounded-2xl ring-1 ring-inset ring-white/15">
          {% image "/assets/img/uploads/gorod-" + city + "-hero-4x3.jpg", cityData.photoCaption, "(min-width: 1024px) 33rem, 90vw", "w-full" %}
        </figure>
      </div>
    </div>
  </section>
  {% elif heroInclude %}{% include heroInclude %}{% endif %}

  <div class="container section">
    <div data-reading class="lg:flex lg:items-start lg:gap-10 xl:gap-16">
      {# ── Колонка контента: ограниченная ширина, комфортная типографика ── #}
      <div
        data-reading-content
        class="w-full min-w-0 lg:max-w-[45rem] lg:flex-1 lg:mx-auto"
      >
        {% if title and showTitle !== false %}
          <h1 class="text-3xl font-bold tracking-tight text-ink md:text-4xl">{{ title }}</h1>
        {% endif %}

        {# Дата публикации (статьи блога/кейсы — ogType article). #}
        {% if date and ogType == "article" %}
          <p class="mt-3 text-sm text-muted">
            <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
          </p>
        {% endif %}

        {# Обложка статьи/кейса — через eleventy-img (AVIF/WebP, srcset, lazy). #}
        {% if cover %}
          <figure class="mt-6 overflow-hidden rounded-2xl border border-slate-200">
            {% image cover, alt, "(min-width: 1024px) 720px, 100vw", "w-full" %}
          </figure>
        {% endif %}

        {# Мобильное «Содержание» (аккордеон). Наполняется и показывается на TS
           при 3+ разделах; на десктопе скрыто (есть правое оглавление). #}
        <div data-toc-mobile hidden class="mt-6 lg:hidden">
          <div class="rounded-xl border border-slate-200 bg-surface-alt">
            <button
              type="button"
              data-toc-mobile-toggle
              class="flex w-full items-center justify-between gap-4 px-5 py-3 text-left text-sm font-semibold text-ink"
              aria-expanded="false"
            >
              <span>{{ "content.toc" | t(locale) }}</span>
              {% from "partials/icon.njk" import icon %}
              {{ icon("chevron-down", "accordion-caret h-5 w-5 shrink-0 text-cyan transition-transform duration-200") }}
            </button>
            <div data-toc-mobile-panel hidden class="hidden px-5 pb-2">
              <ol data-toc-list></ol>
            </div>
          </div>
        </div>

        <div class="prose prose-reading mt-8 max-w-none">
          {{ content | safe }}
        </div>

        {# Перелинковка статья/кейс → услуга («Закажите у нас»). Выводится только
           если related_service задан и услуга есть в индексе (serviceIndex) —
           ссылок на несуществующее нет. #}
        {% if relatedService and serviceIndex[relatedService] %}
          {% set svcLink = serviceIndex[relatedService] %}
          <div class="mt-12 border-t border-slate-200 pt-8">
            <a
              href="{{ svcLink.url | localizedUrl(locale) }}"
              class="group flex items-center gap-4 rounded-xl border border-cyan/40 bg-surface-alt p-5 transition-colors hover:border-cyan focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan"
            >
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-cyan/10">
                {{ icon(svcLink.icon, "h-6 w-6 text-cyan") }}
              </span>
              <span class="flex-1">
                <span class="block text-sm text-muted">{{ "content.orderText" | t(locale) }}</span>
                <span class="mt-0.5 block text-base font-semibold text-ink">{{ svcLink.labelKey | t(locale) }} — {{ "content.orderCta" | t(locale) }}</span>
              </span>
              {{ icon("arrow-right", "h-5 w-5 shrink-0 text-cyan transition-transform group-hover:translate-x-1") }}
            </a>
          </div>
        {% endif %}

        {# Перелинковка торговой услуги — внутри контентной колонки, под FAQ
           (та же ширина, что основной контент). Финальный CTA — ниже, во всю
           ширину. #}
        {% if svc %}{% include "components/service-related.njk" %}{% endif %}
        {% if cityData %}{% include "components/city-related.njk" %}{% endif %}

        {# Обратная связка услуга → статья: на странице услуги ссылка на
           привязанную статью блога (related_service), если она существует. #}
        {% if service and library.byService[service] %}
          {% set relArt = library.byService[service] %}
          <div class="mt-8">
            <a
              href="{{ relArt.url | localizedUrl(locale) }}"
              class="group flex items-center gap-4 rounded-xl border border-slate-200 bg-white p-5 transition-colors hover:border-cyan focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan"
            >
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-cyan/10">
                {{ icon("file-text", "h-6 w-6 text-cyan") }}
              </span>
              <span class="flex-1">
                <span class="block text-sm text-muted">{{ "content.relatedArticleTitle" | t(locale) }}</span>
                <span class="mt-0.5 block text-base font-semibold text-ink">{{ relArt.title }}</span>
              </span>
              {{ icon("arrow-right", "h-5 w-5 shrink-0 text-cyan transition-transform group-hover:translate-x-1") }}
            </a>
          </div>
        {% endif %}
      </div>

      {# ── Правое sticky-оглавление (десктоп). Скрыто, пока TS не наполнит
         его и не покажет (добавит lg:block) при 3+ разделах. Sticky — на самом
         <aside>: он залипает относительно высокой колонки контента (на <nav>
         не сработало бы — родитель по высоте равен оглавлению). ── #}
      <aside
        data-toc-desktop
        class="hidden lg:w-60 lg:shrink-0 lg:self-start lg:sticky lg:top-28"
      >
        <nav aria-label="{{ 'content.toc' | t(locale) }}">
          <p class="text-sm font-semibold text-ink">{{ "content.toc" | t(locale) }}</p>
          <ol data-toc-list class="mt-3 space-y-0.5 border-l border-slate-200"></ol>
        </nav>
      </aside>
    </div>
  </div>

  {# ── Опциональные продающие модули (обрамление, во всю ширину) ── #}
  {% if relatedLinks %}{{ related(relatedLinks, relatedTitle or "Читайте также") }}{% endif %}
  {% if faqItems %}{{ faq(faqItems, faqTitle or "Частые вопросы") }}{% endif %}
  {% if ctaFinal %}{% include "components/cta-final.njk" %}{% endif %}

  {# Финальный CTA торговой услуги (svc) или города (cityData) — полная ширина. #}
  {% if svc %}{% include "components/service-cta.njk" %}{% endif %}
  {% if cityData %}{% include "components/city-cta.njk" %}{% endif %}

  {# JSON-LD Article — для статей блога/кейсов (по флагу страницы). #}
  {% if ogType == "article" %}{% include "partials/schema-article.njk" %}{% endif %}
</main>

{% include "partials/footer.njk" %}
