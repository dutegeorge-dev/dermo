{%- set pageTitle = title or site.defaultTitle -%}
{%- set pageDescription = description or site.defaultDescription -%}
{%- set pageRobots = robots or "index, follow" -%}
{%- set canonicalUrl = site.url + page.url -%}
{%- set ogImageUrl = (ogImage or site.defaultOgImage) | absoluteUrl(site.url) -%}
<!doctype html>
<html lang="{{ locale or site.lang }}"{% if site.analytics.yandexMetrika %} data-ym-id="{{ site.analytics.yandexMetrika }}"{% endif %} data-lead-endpoint="{{ site.leadApiUrl }}" data-form-sending="{{ 'forms.sending' | t(locale or site.lang) }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}" />
    <meta name="robots" content="{{ pageRobots }}" />
    <link rel="canonical" href="{{ canonicalUrl }}" />

    {# hreflang: языковые версии страницы (ru — x-default) #}
    {% for loc in locales %}
    <link rel="alternate" hreflang="{{ loc }}" href="{{ (page.url | localizedUrl(loc)) | absoluteUrl(site.url) }}" />
    {% endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ (page.url | localizedUrl('ru')) | absoluteUrl(site.url) }}" />

    {# Предзагрузка шрифтов hero-секции (включая форму заявки), кириллица+латиница:
       300 — заголовок и подзаголовок, 400 — текст и поля формы, 500 — кнопки и
       подписи. crossorigin обязателен для шрифтов даже на своём домене. #}
    <link rel="preload" href="/assets/fonts/onest-cyrillic-300-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/onest-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/onest-cyrillic-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/onest-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/onest-cyrillic-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/onest-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />

    {# Open Graph #}
    <meta property="og:type" content="{{ ogType or 'website' }}" />
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDescription }}" />
    <meta property="og:url" content="{{ canonicalUrl }}" />
    <meta property="og:image" content="{{ ogImageUrl }}" />
    <meta property="og:locale" content="{{ site.locale }}" />

    {# Верификация поисковых систем (рендерится только если задано в конфиге) #}
    {% if site.verification.yandex %}<meta name="yandex-verification" content="{{ site.verification.yandex }}" />{% endif %}
    {% if site.verification.google %}<meta name="google-site-verification" content="{{ site.verification.google }}" />{% endif %}

    {# Фавиконки (пакет BARS): svg + ico + png + apple-touch + web-манифест. #}
    <link rel="icon" type="image/png" href="/assets/img/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg" />
    <link rel="shortcut icon" href="/assets/img/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon.png" />
    <link rel="manifest" href="/assets/img/site.webmanifest" />
    <link rel="stylesheet" href="/assets/css/styles.css" />

    {# JSON-LD Organization — на всех страницах #}
    {% include "partials/schema-organization.njk" %}

    {# Счётчики аналитики (условно, по наличию ID) #}
    {% include "partials/analytics-yandex.njk" %}
    {% include "partials/analytics-ga.njk" %}
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-gray-900 antialiased">
    {{ content | safe }}

    {# Глобальный баннер согласия на cookies (показывается до согласия). #}
    {% include "partials/cookie-banner.njk" %}

    {# Клиентский скрипт: меню + заглушки форм. defer — без блокировки рендера. #}
    <script src="/assets/js/main.js" defer></script>
  </body>
</html>
