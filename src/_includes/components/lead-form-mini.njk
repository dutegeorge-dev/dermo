{#
  Мини-форма расчёта — единый компонент для hero главной и hero страницы
  логистики. Отправка: POST на бэкенд-обработчик (server/index.ts) → лид в
  Bitrix24. Валидация, состояния и fetch — assets/ts/main.ts. Тексты — из
  словаря (home.heroForm.*, cta.calculate, forms.*).

  Параметры:
    locale     — текущая локаль (передаётся явно: внутри макроса контекст
                 шаблона недоступен, а фильтр t требует локаль);
    id_prefix  — префикс id полей (уникальность на странице; по умолчанию "hero").
#}
{% from "components/form-consent.njk" import formConsent %}
{% macro leadFormMini(locale, id_prefix="hero") %}
<form
  data-lead-form="{{ id_prefix }}"
  novalidate
  class="rounded-2xl bg-surface p-6 text-ink shadow-xl ring-1 ring-black/5 md:p-8"
>
  <h2 class="text-xl font-medium text-ink">{{ "home.heroForm.title" | t(locale) }}</h2>
  <p class="mt-1 text-sm text-muted">{{ "home.heroForm.note" | t(locale) }}</p>

  <div class="mt-5 space-y-4">
    <div>
      <label class="field-label" for="{{ id_prefix }}-cargo">{{ "home.heroForm.cargoLabel" | t(locale) }}</label>
      <input class="field-input min-h-[44px]" id="{{ id_prefix }}-cargo" name="cargo" type="text" data-validate="required" autocomplete="off" />
      <p class="field-error hidden" data-error-for="cargo">{{ "home.heroForm.cargoError" | t(locale) }}</p>
    </div>
    <div>
      <label class="field-label" for="{{ id_prefix }}-contact">{{ "home.heroForm.contactLabel" | t(locale) }}</label>
      <input class="field-input min-h-[44px]" id="{{ id_prefix }}-contact" name="contact" type="text" placeholder="+7 (___) ___-__-__ · @логин в Telegram / Макс" data-validate="contact" autocomplete="off" />
      <p class="field-error hidden" data-error-for="contact">{{ "home.heroForm.contactError" | t(locale) }}</p>
    </div>

    {{ formConsent(locale, id_prefix) }}

    {# Ловушка для ботов: поле скрыто от людей, заполнение = спам. #}
    <div class="hidden" aria-hidden="true">
      <label for="{{ id_prefix }}-company">Не заполняйте это поле</label>
      <input id="{{ id_prefix }}-company" name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <button
      type="submit"
      class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg bg-accent px-6 py-3 text-base font-medium text-white transition-colors hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60"
    >
      {{ "cta.calculate" | t(locale) }}
    </button>

    <p class="hidden rounded-md bg-green-50 px-4 py-3 text-sm text-green-700" data-form-success role="status">
      {{ "home.heroForm.success" | t(locale) }}
    </p>
    <p class="hidden rounded-md bg-red-50 px-4 py-3 text-sm text-red-700" data-form-error role="alert">
      {{ "forms.sendError" | t(locale) }}
    </p>
  </div>
</form>
{% endmacro %}
