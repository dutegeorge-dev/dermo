{#
  Перелинковка страницы услуги (читательский шаблон). Опциональный продающий
  модуль ВНУТРИ контентной колонки, сразу под FAQ (ширина — как у контента).
  Состав:
    - «Вместе с этим заказывают» — карточки-ссылки на связанные услуги;
    - связанный кейс — живая строка-ссылка (только если svc.caseUrl задан);
    - «Нужен полный цикл?» — ссылка на витрину направления.
  Связанная статья/кейс выводятся только при наличии URL — ссылок на
  ненаписанное не ставим. Данные — глобальный `svc` (services.ts).
#}
{% from "partials/icon.njk" import icon %}
{% from "components/link-card.njk" import linkCard %}

<div class="mt-12 border-t border-slate-200 pt-8">
  <h2 class="text-2xl font-semibold tracking-tight text-ink md:text-3xl">
    {{ (svc.i18nBase + ".relatedTitle") | t(locale) }}
  </h2>
  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    {% for item in svc.related %}
      {{ linkCard(item.icon, (item.labelKey | t(locale)), item.url | localizedUrl(locale)) }}
    {% endfor %}
  </div>

  {# Связанный кейс — живая строка-ссылка (бирюзовый акцент). #}
  {% if svc.caseUrl %}
    <p class="mt-6">
      <a
        href="{{ svc.caseUrl | localizedUrl(locale) }}"
        class="group inline-flex items-center gap-2 text-base font-medium text-cyan-dark transition-colors hover:text-cyan"
      >
        {{ (svc.i18nBase + ".caseLink") | t(locale) }}
        {{ icon("arrow-right", "h-4 w-4 shrink-0 transition-transform group-hover:translate-x-1") }}
      </a>
    </p>
  {% endif %}

  {# «Нужен полный цикл?» — переход на витрину направления. #}
  <a
    href="{{ svc.fullCycleUrl | localizedUrl(locale) }}"
    class="group mt-6 flex items-center gap-4 rounded-xl border border-cyan/40 bg-surface-alt p-5 transition-colors hover:border-cyan focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan"
  >
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-cyan/10">
      {{ icon("handshake", "h-6 w-6 text-cyan") }}
    </span>
    <span class="flex-1">
      <span class="block text-base font-semibold text-ink">{{ (svc.i18nBase + ".fullCycle.label") | t(locale) }}</span>
      <span class="mt-0.5 block text-sm text-muted">{{ (svc.i18nBase + ".fullCycle.text") | t(locale) }}</span>
    </span>
    {{ icon("arrow-right", "h-5 w-5 shrink-0 text-cyan transition-transform group-hover:translate-x-1") }}
  </a>
</div>
