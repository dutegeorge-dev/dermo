{#
  Блог: последние статьи. Рендерятся из контентной библиотеки (library.blog по
  текущей локали — Markdown-статьи с фолбэком на русский); если статей ещё нет —
  из плейсхолдеров _data/homeBlog.ts. Обложки — через eleventy-img (lazy, srcset).
  Карточка кликабельна целиком. Фон surface-alt.
#}
{% from "partials/icon.njk" import icon %}

{% set libItems = library.blog[locale] %}
{% if libItems and libItems.length %}
  {% set items = libItems %}
{% else %}
  {% set items = homeBlog %}
{% endif %}

<section class="bg-surface-alt">
  <div class="container section">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-3xl font-light tracking-tight text-ink md:text-4xl">{{ "home.blog.title" | t(locale) }}</h2>
      <a href="{{ '/blog/' | localizedUrl(locale) }}" class="inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-cyan-dark transition-colors hover:text-cyan">
        {{ "home.blog.all" | t(locale) }}
        {{ icon("arrow-right", "h-4 w-4") }}
      </a>
    </div>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {% for item in items %}
        {% if loop.index0 < 3 %}
        <a
          href="{{ item.url }}"
          class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-surface shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan"
        >
          {% if item.cover %}
            {% image item.cover, item.alt or item.title, "(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw", "aspect-[16/10] w-full object-cover" %}
          {% else %}
            <span class="flex aspect-[16/10] w-full items-center justify-center bg-surface-alt" aria-hidden="true">
              {{ icon("file-text", "h-10 w-10 text-slate-300") }}
            </span>
          {% endif %}
          <div class="flex flex-1 flex-col p-6">
            {% if item.date %}<time datetime="{{ item.date | isoDate }}" class="text-xs font-medium uppercase tracking-wide text-muted">{{ item.date | readableDate }}</time>{% endif %}
            <h3 class="mt-2 text-lg font-medium text-ink">{{ item.title }}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{{ item.description }}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-cyan-dark transition-colors group-hover:text-cyan">
              {{ "home.blog.read" | t(locale) }}
              {{ icon("arrow-right", "h-4 w-4") }}
            </span>
          </div>
        </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
