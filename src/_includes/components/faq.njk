{#
  Переиспользуемый FAQ-аккордеон + микроразметка FAQPage.
  Дизайн единый с лендингами (/logistika/, /torgovlya/), поведение — общий
  аккордеон (data-accordion-toggle/panel, см. assets/ts/header.ts).

  Параметры:
    items — массив { q, a } уже разрешённых строк (вопрос/ответ);
    title — заголовок секции (опц.).
  Использование:
    {% from "components/faq.njk" import faq %}
    {{ faq(items, "Частые вопросы") }}
#}
{% from "partials/icon.njk" import icon %}

{% macro faq(items, title="Частые вопросы") %}
{% if items and items.length %}
<section id="faq" class="scroll-mt-28 bg-surface-alt">
  <div class="container section">
    <div class="container-narrow !px-0">
      <h2 class="text-2xl font-semibold tracking-tight text-ink md:text-3xl">{{ title }}</h2>
      <div class="mt-8 rounded-xl border border-slate-200 bg-white px-5 sm:px-6">
        {% for item in items %}
          <div class="border-b border-slate-200 last:border-b-0">
            <button
              type="button"
              data-accordion-toggle
              class="flex w-full items-center justify-between gap-4 py-4 text-left text-base font-medium text-ink"
              aria-expanded="false"
              aria-controls="faq-panel-{{ loop.index }}"
            >
              <span>{{ item.q }}</span>
              {{ icon("chevron-down", "accordion-caret h-5 w-5 shrink-0 text-cyan transition-transform duration-200") }}
            </button>
            <div id="faq-panel-{{ loop.index }}" data-accordion-panel class="hidden pb-4" hidden>
              <p class="max-w-2xl text-sm leading-relaxed text-muted">{{ item.a | safe }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  {# JSON-LD FAQPage — микроразметка для поисковой выдачи. #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for item in items %}
      {
        "@type": "Question",
        "name": {{ item.q | dump | safe }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ item.a | dump | safe }}
        }
      }{% if not loop.last %},{% endif %}
      {%- endfor %}
    ]
  }
  </script>
</section>
{% endif %}
{% endmacro %}
