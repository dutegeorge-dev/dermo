{#
  Кейсы. Рендерятся из контентной библиотеки (library.kejsy по текущей локали —
  Markdown-кейсы с фолбэком на русский); если кейсов ещё нет — из плейсхолдеров
  _data/homeCases.ts. Обложки — через eleventy-img (lazy, srcset). Показываем
  итог-result, если задан. Карточка кликабельна целиком.
#}
{% from "partials/icon.njk" import icon %}

{% set libItems = library.kejsy[locale] %}
{% if libItems and libItems.length %}
  {% set items = libItems %}
{% else %}
  {% set items = homeCases %}
{% endif %}

<section class="bg-surface">
  <div class="container section">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-3xl font-light tracking-tight text-ink md:text-4xl">{{ "home.cases.title" | t(locale) }}</h2>
      <a href="{{ '/kejsy/' | localizedUrl(locale) }}" class="inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-cyan-dark transition-colors hover:text-cyan">
        {{ "home.cases.all" | t(locale) }}
        {{ icon("arrow-right", "h-4 w-4") }}
      </a>
    </div>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {% for item in items %}
        {% if loop.index0 < 3 %}
        <a
          href="{{ item.url }}"
          class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-surface shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan"
        >
          {% if item.cover %}
            {% image item.cover, item.alt or item.title, "(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw", "aspect-[16/10] w-full object-cover" %}
          {% else %}
            <span class="flex aspect-[16/10] w-full items-center justify-center bg-surface-alt" aria-hidden="true">
              {{ icon("package", "h-10 w-10 text-slate-300") }}
            </span>
          {% endif %}
          <div class="flex flex-1 flex-col p-6">
            {% if item.result %}
              <span class="mb-1 inline-flex w-fit rounded-full bg-cyan/10 px-3 py-1 text-xs font-semibold text-cyan-dark">{{ item.result }}</span>
            {% endif %}
            <h3 class="text-lg font-medium text-ink">{{ item.title }}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{{ item.description }}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-cyan-dark transition-colors group-hover:text-cyan">
              {{ "home.cases.more" | t(locale) }}
              {{ icon("arrow-right", "h-4 w-4") }}
            </span>
          </div>
        </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
