{#
  Сетка карточек витрины блога/кейсов (навигаторное оформление, не читательское).
  Ожидает в контексте:
    items          — массив карточек из library (url, title, description, cover,
                     alt, date, result); url уже локализован под язык витрины;
    listKind       — "blog" | "kejsy" (что показывать: дату или итог-result);
    listLang       — язык витрины (для CTA-надписи карточки);
    placeholderIcon — иконка-заглушка для карточек без обложки;
    emptyText      — текст пустого состояния.
  Обложки прогоняются через eleventy-img (AVIF/WebP, srcset, lazy, без CLS).
#}
{% from "partials/icon.njk" import icon %}

{% if items and items.length %}
  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {% for item in items %}
      <a
        href="{{ item.url }}"
        class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-surface shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan"
      >
        {% if item.cover %}
          {% image item.cover, item.alt, "(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw", "aspect-[16/10] w-full object-cover" %}
        {% else %}
          <span class="flex aspect-[16/10] w-full items-center justify-center bg-surface-alt" aria-hidden="true">
            {{ icon(placeholderIcon, "h-10 w-10 text-slate-300") }}
          </span>
        {% endif %}
        <div class="flex flex-1 flex-col p-6">
          {% if listKind == "blog" and item.date %}
            <time datetime="{{ item.date | isoDate }}" class="text-xs font-medium uppercase tracking-wide text-muted">{{ item.date | readableDate }}</time>
          {% endif %}
          {% if listKind == "kejsy" and item.result %}
            <span class="mb-1 inline-flex w-fit rounded-full bg-cyan/10 px-3 py-1 text-xs font-semibold text-cyan-dark">{{ item.result }}</span>
          {% endif %}
          <h3 class="mt-2 text-lg font-medium text-ink">{{ item.title }}</h3>
          {% if item.description %}<p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{{ item.description }}</p>{% endif %}
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-cyan-dark transition-colors group-hover:text-cyan">
            {{ "content.readMore" | t(listLang) }}
            {{ icon("arrow-right", "h-4 w-4") }}
          </span>
        </div>
      </a>
    {% endfor %}
  </div>
{% else %}
  {% from "components/empty-state.njk" import emptyState %}
  <div class="mt-8">{{ emptyState(emptyText) }}</div>
{% endif %}
