{#
  Плейсхолдер под фотографию (место под реальное фото, не декоративная иконка).
  Заменяется реальным <img> позже. Подпись — что должно быть на фото.
  Параметры:
    caption — подпись/описание будущего фото (идёт в aria-label и видимую подпись);
    tone    — "dark" (на ультрамариновом hero) или "light" (в контентной колонке).
  Использование:
    {% from "components/photo-placeholder.njk" import photoPlaceholder %}
    {{ photoPlaceholder("Фото: команда на фабрике", "dark") }}
#}
{% from "partials/icon.njk" import icon %}

{% macro photoPlaceholder(caption, tone="light") %}
{% if tone == "dark" %}
<div
  class="flex aspect-[4/3] flex-col items-center justify-center gap-3 rounded-2xl bg-white/5 text-white/45 ring-1 ring-inset ring-white/15"
  role="img"
  aria-label="{{ caption }}"
>
  {{ icon("camera", "h-10 w-10") }}
  <span class="max-w-[16rem] px-4 text-center text-xs leading-snug">{{ caption }}</span>
</div>
{% else %}
<figure class="my-2 overflow-hidden rounded-xl border border-dashed border-slate-300 bg-surface-alt">
  <div
    class="flex aspect-[16/9] flex-col items-center justify-center gap-2 text-slate-400"
    role="img"
    aria-label="{{ caption }}"
  >
    {{ icon("camera", "h-9 w-9") }}
    <span class="max-w-[20rem] px-4 text-center text-xs leading-snug text-muted">{{ caption }}</span>
  </div>
</figure>
{% endif %}
{% endmacro %}
