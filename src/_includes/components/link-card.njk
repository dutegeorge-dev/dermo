{#
  Простая карточка-ссылка раздела «Услуги»: иконка (бирюза) + название + стрелка.
  Единый вид для всех сеток услуг (витрины и списки).
  Использование:
    {% from "components/link-card.njk" import linkCard %}
    {{ linkCard(icon, label, url) }}
#}
{% from "partials/icon.njk" import icon %}

{% macro linkCard(iconName, label, url) %}
  <a href="{{ url }}" class="group flex items-center gap-4 rounded-xl border border-slate-200 bg-white p-5 transition-colors hover:border-cyan focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan">
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-cyan/10">
      {{ icon(iconName, "h-6 w-6 text-cyan") }}
    </span>
    <span class="flex-1 text-base font-semibold text-ink">{{ label }}</span>
    {{ icon("arrow-right", "h-5 w-5 shrink-0 text-cyan transition-transform group-hover:translate-x-1") }}
  </a>
{% endmacro %}
