{#
  Мега-меню «Услуги» (десктоп). Оверлей на всю ширину контейнера.
  Рендерится из data/megaMenu.ts; тексты — из словаря (t), иконки — Lucide (бирюза).
  Два крыла: Логистика (шире) | Торговля (уже), разделены вертикальной линией.
#}
{% from "partials/icon.njk" import icon %}

<div class="mega-panel" data-mega-panel>
  <div class="overflow-hidden rounded-b-2xl border-t-2 border-cyan bg-surface shadow-2xl ring-1 ring-slate-200">
    <div class="grid gap-8 p-8 lg:grid-cols-[1.7fr_minmax(0,1fr)]">

      {# ── Левое крыло: ЛОГИСТИКА ─────────────────────────────────── #}
      {# flex-col + h-full: крыло на высоту строки сетки, кнопка «все услуги» —
         к низу (mt-auto), как у «Торговли». #}
      <div class="flex h-full flex-col lg:border-r lg:border-slate-200 lg:pr-8">
        {# Кликабельные «ворота» — вход на экспертную страницу. #}
        <a
          href="{{ megaMenu.logistics.gate.url | localizedUrl(locale) }}"
          class="group/gate flex items-start justify-between gap-4 rounded-xl border-l-4 border-l-cyan bg-cyan/5 p-4 ring-1 ring-transparent transition hover:bg-white hover:ring-cyan focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan"
        >
          <span>
            <span class="block text-sm font-semibold uppercase tracking-wider text-cyan-dark">{{ megaMenu.logistics.gate.titleKey | t(locale) }}</span>
            <span class="mt-1 block text-sm text-muted">{{ megaMenu.logistics.gate.subtitleKey | t(locale) }}</span>
          </span>
          {{ icon("arrow-right", "h-5 w-5 shrink-0 text-cyan transition-transform group-hover/gate:translate-x-1") }}
        </a>

        {# Подгруппы в двух колонках. Колонка 1 — «По способу» + «Дополнительные
           услуги» (в одну колонку, singleCol); колонка 2 — «По товару» + «По
           городу». Распределение — по полю group.column (рендер групп идентичен). #}
        <div class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2">
          {# Колонка 1 — flex-col на всю высоту: «По способу» сверху,
             «Дополнительные услуги» (pinBottom) прижаты к низу, чтобы их линия
             совпала с «По городу» в колонке 2. #}
          <div class="flex h-full flex-col">
            {% for group in megaMenu.logistics.groups %}{% if group.column == 1 %}
              <div{% if group.pinBottom %} class="mt-auto pt-6"{% endif %}>
                <a href="{{ group.url | localizedUrl(locale) }}" class="inline-flex items-center gap-1 text-sm font-medium text-ink transition-colors hover:text-cyan focus-visible:outline-none focus-visible:text-cyan">
                  {{ group.titleKey | t(locale) }}
                  {{ icon("chevron-right", "h-4 w-4 text-cyan") }}
                </a>
                <ul class="mt-3 grid {% if group.singleCol %}grid-cols-1{% else %}grid-cols-2{% endif %} gap-x-4 gap-y-1">
                  {% for item in group.items %}
                    <li>
                      <a href="{{ item.url | localizedUrl(locale) }}" class="flex items-center gap-2 rounded-md py-1 text-sm text-muted transition-colors hover:text-cyan focus-visible:outline-none focus-visible:text-cyan">
                        {% if item.icon %}{{ icon(item.icon, "h-4 w-4 shrink-0 text-cyan") }}{% endif %}
                        <span>{{ item.titleKey | t(locale) }}</span>
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}{% endfor %}
          </div>
          <div class="space-y-6">
            {% for group in megaMenu.logistics.groups %}{% if group.column != 1 %}
              <div>
                <a href="{{ group.url | localizedUrl(locale) }}" class="inline-flex items-center gap-1 text-sm font-medium text-ink transition-colors hover:text-cyan focus-visible:outline-none focus-visible:text-cyan">
                  {{ group.titleKey | t(locale) }}
                  {{ icon("chevron-right", "h-4 w-4 text-cyan") }}
                </a>
                <ul class="mt-3 grid {% if group.singleCol %}grid-cols-1{% else %}grid-cols-2{% endif %} gap-x-4 gap-y-1">
                  {% for item in group.items %}
                    <li>
                      <a href="{{ item.url | localizedUrl(locale) }}" class="flex items-center gap-2 rounded-md py-1 text-sm text-muted transition-colors hover:text-cyan focus-visible:outline-none focus-visible:text-cyan">
                        {% if item.icon %}{{ icon(item.icon, "h-4 w-4 shrink-0 text-cyan") }}{% endif %}
                        <span>{{ item.titleKey | t(locale) }}</span>
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}{% endfor %}
          </div>
        </div>

        {# Кнопка на витрину со всеми услугами доставки — внизу крыла. #}
        <div class="mt-auto pt-6">
          <a
            href="{{ megaMenu.logistics.allUrl | localizedUrl(locale) }}"
            class="group/all flex items-center justify-center gap-1.5 rounded-lg border border-cyan/40 bg-cyan/5 px-4 py-2.5 text-sm font-medium text-cyan-dark transition-colors hover:bg-cyan hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan"
          >
            {{ "mega.allServices" | t(locale) }}
            {{ icon("arrow-right", "h-4 w-4 transition-transform group-hover/all:translate-x-1") }}
          </a>
        </div>
      </div>

      {# ── Правое крыло: ТОРГОВЛЯ ──────────────────────────────────── #}
      {# flex-col + h-full: крыло растягивается на высоту строки сетки (=высота
         «Логистики»), кнопка «все услуги» прижимается к низу (mt-auto). #}
      <div class="flex h-full flex-col">
        <a
          href="{{ megaMenu.trade.gate.url | localizedUrl(locale) }}"
          class="group/gate flex items-start justify-between gap-4 rounded-xl border-l-4 border-l-accent bg-accent/5 p-4 ring-1 ring-transparent transition hover:bg-white hover:ring-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          <span>
            <span class="block text-sm font-semibold uppercase tracking-wider text-accent-dark">{{ megaMenu.trade.gate.titleKey | t(locale) }}</span>
            <span class="mt-1 block text-sm text-muted">{{ megaMenu.trade.gate.subtitleKey | t(locale) }}</span>
          </span>
          {{ icon("arrow-right", "h-5 w-5 shrink-0 text-accent-dark transition-transform group-hover/gate:translate-x-1") }}
        </a>

        <ul class="mt-6 space-y-1">
          {% for service in megaMenu.trade.services %}
            <li>
              <a
                href="{{ service.url | localizedUrl(locale) }}"
                class="flex items-center gap-3 rounded-lg p-2 text-sm text-ink transition-colors hover:bg-accent/5 hover:text-accent-dark focus-visible:outline-none focus-visible:bg-accent/5"
              >
                {{ icon(service.icon, "h-5 w-5 shrink-0 text-accent-dark") }}
                <span>{{ service.titleKey | t(locale) }}</span>
              </a>
            </li>
          {% endfor %}
        </ul>

        {# Кнопка на витрину со всеми услугами — прижата к низу крыла (mt-auto),
           но не ближе pt-6 к списку, когда крыло не растянуто. #}
        <div class="mt-auto pt-6">
          <a
            href="{{ megaMenu.trade.allUrl | localizedUrl(locale) }}"
            class="group/all flex items-center justify-center gap-1.5 rounded-lg border border-accent/40 bg-accent/5 px-4 py-2.5 text-sm font-medium text-accent-dark transition-colors hover:bg-accent hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            {{ "mega.allServices" | t(locale) }}
            {{ icon("arrow-right", "h-4 w-4 transition-transform group-hover/all:translate-x-1") }}
          </a>
        </div>
      </div>

    </div>
  </div>
</div>
