{#
  Контент товарной страницы (эталон — напольные покрытия; расширен под запчасти).
  Общий костяк для всех товарных категорий; разделы рендерятся только если есть
  в данных. Уникальность (защита от дублей) = виды товара, специфика «почему мы»
  и оптимальный способ доставки под категорию.
  Данные — dict.uslugi.tovary[tovarKey] (tovarKey из front matter страницы).
#}
{% from "partials/icon.njk" import icon %}
{% set P = dict.uslugi.tovary[tovarKey] %}
{% set svc = services[service] %}

{# Раздел 1 — Что мы поставляем. Карточки видов с фото ИЛИ бренды + категории. #}
<section id="{{ P.chtoPostavlyaem.id or 'chto-postavlyaem' }}" class="scroll-mt-28">
  <h2>{{ P.chtoPostavlyaem.title }}</h2>
  <p>{{ P.chtoPostavlyaem.intro }}</p>

  {% if P.chtoPostavlyaem.products %}
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {% for p in P.chtoPostavlyaem.products %}
        <div class="overflow-hidden rounded-xl border border-slate-200">
          {# Фото вида товара — заглушка 4:3 (заменяется через Decap:
             tovar-<ключ>-<N>-4x3.jpg). #}
          {% image "/assets/img/uploads/tovar-" + tovarKey + "-" + loop.index + "-4x3.jpg", p.photoCaption, "(min-width: 640px) 22rem, 90vw", "aspect-[4/3] w-full object-cover" %}
          <div class="p-4">
            <span class="block text-base font-semibold text-ink">{{ p.name }}</span>
            {% if p.linkUrl and p.linkLabel %}
              <a href="{{ p.linkUrl | localizedUrl(locale) }}" class="mt-2 inline-flex items-center gap-1.5 text-sm font-medium text-cyan-dark no-underline transition-colors hover:text-cyan">
                {{ p.linkLabel }}
                {{ icon("arrow-right", "h-4 w-4 shrink-0") }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
    {% if P.chtoPostavlyaem.outro %}<p class="mt-6">{{ P.chtoPostavlyaem.outro }}</p>{% endif %}
  {% else %}
    {% if P.chtoPostavlyaem.brands %}<p><strong>Бренды:</strong> {{ P.chtoPostavlyaem.brands }}</p>{% endif %}
    {% if P.chtoPostavlyaem.detailCategories %}
      <p><strong>{{ P.chtoPostavlyaem.detailCategories.label }}:</strong></p>
      <ul>
        {% for d in P.chtoPostavlyaem.detailCategories.items %}<li>{{ d }}</li>{% endfor %}
      </ul>
    {% endif %}
    {% if P.chtoPostavlyaem.outro %}<p>{{ P.chtoPostavlyaem.outro }}</p>{% endif %}
    {% if svc.caseUrl and P.caseLink %}
      <p>
        <a href="{{ svc.caseUrl | localizedUrl(locale) }}" class="group inline-flex items-center gap-1.5 font-medium text-cyan-dark no-underline transition-colors hover:text-cyan">
          {{ P.caseLink }}
          {{ icon("arrow-right", "h-4 w-4 shrink-0 transition-transform group-hover:translate-x-1") }}
        </a>
      </p>
    {% endif %}
  {% endif %}
</section>

{# Раздел (опц.) — Категории качества (таблица + вывод). #}
{% if P.kategorii %}
<section id="kategorii" class="scroll-mt-28">
  <h2>{{ P.kategorii.title }}</h2>
  <div class="mt-5 overflow-x-auto">
    <table class="w-full min-w-[34rem] border-collapse text-left text-sm">
      <thead>
        <tr class="border-b border-slate-200">
          <th class="py-3 pr-4 font-semibold text-ink">{{ P.kategorii.columns.category }}</th>
          <th class="px-4 py-3 font-medium text-muted">{{ P.kategorii.columns.what }}</th>
          <th class="px-4 py-3 font-medium text-muted">{{ P.kategorii.columns.when }}</th>
        </tr>
      </thead>
      <tbody>
        {% for r in P.kategorii.rows %}
        <tr class="border-b border-slate-200 align-top last:border-b-0">
          <td class="py-3 pr-4 font-semibold text-ink">{{ r.category }}</td>
          <td class="px-4 py-3 text-muted">{{ r.what }}</td>
          <td class="px-4 py-3 text-muted">{{ r.when }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% if P.kategorii.closing %}<p class="reading-takeaway">{{ P.kategorii.closing }}</p>{% endif %}
</section>
{% endif %}

{# Раздел (опц.) — Двигатели в сборе / пояснение прозой + вывод. #}
{% if P.dvigateli %}
<section id="dvigateli" class="scroll-mt-28">
  <h2>{{ P.dvigateli.title }}</h2>
  <p>{{ P.dvigateli.intro }}</p>
  {% if P.dvigateli.closing %}<p class="reading-takeaway">{{ P.dvigateli.closing }}</p>{% endif %}
</section>
{% endif %}

{# Доп. смысловые разделы (опц., произвольный порядок): напр. без параллельного
   импорта, производство под бренд, сертификация. #}
{% if P.extraSections %}
  {% for sec in P.extraSections %}
    <section id="{{ sec.id }}" class="scroll-mt-28">
      <h2>{{ sec.title }}</h2>
      <p>{{ sec.intro }}</p>
      {% if sec.items %}
        <ul>
          {% for it in sec.items %}<li><strong>{{ it.lead }}</strong> {{ it.text }}</li>{% endfor %}
        </ul>
      {% endif %}
      {% if sec.intro2 %}<p>{{ sec.intro2 }}</p>{% endif %}
      {% if sec.closing %}<p class="reading-takeaway">{{ sec.closing }}</p>{% endif %}
    </section>
  {% endfor %}
{% endif %}

{# Раздел (опц.) — Почему мы по этой категории (преимущества + вывод-акцент). #}
{% if P.otlichieList %}
<section id="pochemu-my" class="scroll-mt-28">
  <h2>{{ P.otlichieList.title }}</h2>
  {% if P.otlichieList.intro %}<p>{{ P.otlichieList.intro }}</p>{% endif %}
  <ul>
    {% for it in P.otlichieList.items %}<li><strong>{{ it.lead }}</strong> {{ it.text }}</li>{% endfor %}
  </ul>
  {% if P.otlichieList.closing %}<p class="reading-takeaway">{{ P.otlichieList.closing }}</p>{% endif %}
</section>
{% endif %}

{# Раздел — Как мы доставляем (прозой или со списком способов + вывод). #}
<section id="kak-dostavlyaem" class="scroll-mt-28">
  <h2>{{ P.kakDostavlyaem.title }}</h2>
  <p>{{ P.kakDostavlyaem.intro }}</p>
  {% if P.kakDostavlyaem.items %}
    <ul>
      {% for it in P.kakDostavlyaem.items %}<li><strong>{{ it.lead }}</strong> {{ it.text }}</li>{% endfor %}
    </ul>
  {% endif %}
  {% if P.kakDostavlyaem.intro2 %}<p>{{ P.kakDostavlyaem.intro2 }}</p>{% endif %}
  {% if P.kakDostavlyaem.closing %}<p class="reading-takeaway">{{ P.kakDostavlyaem.closing }}</p>{% endif %}
</section>

{# Раздел — Что вы получаете. #}
<section id="chto-poluchaete" class="scroll-mt-28">
  <h2>{{ P.chtoPoluchaete.title }}</h2>
  <ul>
    {% for item in P.chtoPoluchaete.items %}<li>{{ item }}</li>{% endfor %}
  </ul>
</section>

{# Раздел — FAQ-аккордеон (в оглавление) + FAQPage. #}
<section id="faq" class="scroll-mt-28">
  <h2>{{ P.faqTitle }}</h2>
  <div class="mt-6 rounded-xl border border-slate-200 bg-white px-5 sm:px-6">
    {% for item in P.faq %}
      <div class="border-b border-slate-200 last:border-b-0">
        <button
          type="button"
          data-accordion-toggle
          class="flex w-full items-center justify-between gap-4 py-4 text-left text-base font-medium text-ink"
          aria-expanded="false"
          aria-controls="faq-panel-{{ loop.index }}"
        >
          <span>{{ item.q }}</span>
          {{ icon("chevron-down", "accordion-caret h-5 w-5 shrink-0 text-cyan transition-transform duration-200") }}
        </button>
        <div id="faq-panel-{{ loop.index }}" data-accordion-panel class="hidden pb-4" hidden>
          <p class="text-sm leading-relaxed text-muted">{{ item.a }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{# JSON-LD: FAQPage + Service. #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for item in P.faq %}
    { "@type": "Question", "name": {{ item.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} } }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": {{ P.hero.title | dump | safe }},
  "serviceType": "Поставка товаров из Китая",
  "description": {{ P.metaDescription | dump | safe }},
  "url": {{ (site.url + page.url) | dump | safe }},
  "areaServed": "RU",
  "provider": { "@type": "Organization", "name": {{ site.legalName | dump | safe }}, "url": {{ site.url | dump | safe }} }
}
</script>
