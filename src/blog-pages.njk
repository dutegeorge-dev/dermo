---
# Генератор страниц статей блога из контентной библиотеки (src/_data/library.ts).
# По одной странице на каждую языковую версию (ru + en/zh с фолбэком на ru):
# /blog/<slug>/, /en/blog/<slug>/, /zh/blog/<slug>/. Рендерится на читательском
# шаблоне (sticky-оглавление строится из заголовков Markdown на клиенте).
pagination:
  data: library.renderBlog
  size: 1
  alias: doc
  addAllPagesToCollections: true
permalink: "{{ doc.url }}"
layout: layouts/reading.njk
tags: blog
ogType: article
sitemap: true
eleventyComputed:
  title: "{{ doc.title }}"
  description: "{{ doc.description }}"
  date: "{{ doc.date }}"
  cover: "{{ doc.cover }}"
  alt: "{{ doc.alt }}"
  ogImage: "{{ doc.cover }}"
  relatedService: "{{ doc.relatedService }}"
---
{{ doc.html | safe }}
