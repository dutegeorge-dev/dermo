# Пример переменных окружения. Скопируйте в .env и заполните значениями.
# Реальные ID НЕ хранятся в репозитории.

# Базовый URL сайта (без завершающего слеша) — для canonical/OG/sitemap.
SITE_URL=https://tlkbars.ru

# Аналитика. Если не задано — счётчики не подключаются (удобно для dev).
YM_COUNTER_ID=
GA4_ID=

# Верификация поисковых систем (содержимое meta-тегов).
YANDEX_VERIFICATION=
GOOGLE_VERIFICATION=

# ── Заявки с форм → Bitrix24 CRM (бэкенд server/, см. README) ──────────────

# Входящий вебхук Bitrix24 с правом crm. Берётся в портале:
# «Приложения → Разработчикам → Другое → Входящий вебхук».
# Можно вставить и базовый URL, и полную ссылку на метод из карточки вебхука —
# обработчик сам обрежет метод и query-строку.
# ВАЖНО: это секрет, реальное значение живёт только в .env (он в .gitignore).
BITRIX_WEBHOOK_URL=https://<портал>.bitrix24.ru/rest/<user_id>/<token>/

# Источник лида в CRM (справочник «Источники»). По умолчанию WEB.
BITRIX_SOURCE_ID=WEB
# ID ответственного за лид. Пусто — Bitrix24 назначит по своим правилам.
BITRIX_ASSIGNED_BY_ID=
# Таймаут запроса к порталу, мс.
BITRIX_TIMEOUT_MS=10000

# Порт и адрес обработчика заявок.
LEAD_PORT=3000
LEAD_HOST=0.0.0.0
# Путь эндпоинта приёма заявок.
LEAD_PATH=/api/lead

# Куда браузер шлёт заявку (значение попадает в data-lead-endpoint вёрстки).
# Прод за обратным прокси: /api/lead. Локально: http://localhost:3000/api/lead.
LEAD_API_URL=http://localhost:3000/api/lead

# Разрешённые Origin для CORS, через запятую. SITE_URL и localhost:8080
# добавляются автоматически.
LEAD_ALLOWED_ORIGINS=

# Антиспам: не больше N заявок с одного IP за окно (мс).
LEAD_RATE_LIMIT=10
LEAD_RATE_WINDOW_MS=60000

# ── Курсы валют ЦБ РФ для калькулятора (/calculator/) ──────────────────────
# Путь эндпоинта, который отдаёт курсы фронту.
RATES_PATH=/api/rates
# Куда браузер ходит за курсами (значение попадает в data-rates-endpoint).
# Прод за обратным прокси: /api/rates. Локально: http://localhost:3000/api/rates.
RATES_API_URL=http://localhost:3000/api/rates
# Источники курса ЦБ: основной (готовый JSON) и резервный (официальный XML).
RATES_JSON_URL=https://www.cbr-xml-daily.ru/daily_json.js
RATES_XML_URL=https://www.cbr.ru/scripts/XML_daily.asp
# Сколько держать курс в памяти, мс (ЦБ публикует его раз в сутки).
RATES_TTL_MS=21600000
RATES_TIMEOUT_MS=8000
# Файл последних известных курсов: переживает перезапуск службы и служит
# запасным вариантом, если ЦБ недоступен.
RATES_CACHE_FILE=logs/rates-cache.json

# ── Дубль заявки в Telegram (необязательно) ────────────────────────────────
# Токен бота от @BotFather. ВАЖНО: секрет, реальное значение только в .env.
# Пусто — уведомления просто не отправляются, заявки всё равно идут в CRM.
TELEGRAM_BOT_TOKEN=
# ID чата (свой узнать у @userinfobot). Несколько получателей — через запятую.
# Каждый получатель должен сам написать боту /start, иначе Telegram
# не разрешит боту первым начать переписку.
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_MS=10000
