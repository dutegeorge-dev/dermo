# Обработчик заявок с форм сайта (→ Bitrix24 CRM + Telegram) и шлюз админки CMS.
#
# Кроме заявок этот сервис обслуживает вход в админку (логин/пароль из .env),
# проксирует протокол Decap на локальный decap-server (служба bars-cms) и после
# каждой правки пересобирает сайт (npm run build:11ty). Поэтому ему нужен доступ
# на запись во весь каталог репозитория (сборка пишет в _site).
#
# Установка:
#   sudo cp deploy/systemd/bars-lead.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bars-lead
#   systemctl status bars-lead
#   journalctl -u bars-lead -f          # логи заявок
#
# Секреты (BITRIX_WEBHOOK_URL, TELEGRAM_BOT_TOKEN) обработчик читает сам из
# .env в WorkingDirectory — в юните их дублировать не нужно.
#
# ⚠️ Пути ниже указаны под раскладку «репозиторий в /var/www/tlkbars/repo»
# (root nginx при этом — /var/www/tlkbars/repo/_site). Свой путь — правьте
# WorkingDirectory и ReadWritePaths.

[Unit]
Description=ТЛК БАРС — обработчик заявок (Bitrix24 + Telegram)
Documentation=https://github.com/dutegeorge-dev/dermo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/tlkbars/repo

# По умолчанию — через tsx (работает на Node 20, см. .nvmrc). tsx ставится
# из devDependencies (npm ci --include=dev).
ExecStart=/usr/bin/node --import tsx server/index.ts
# На Node ≥ 22.18 TypeScript исполняется нативно — можно без tsx:
# ExecStart=/usr/bin/node server/index.ts

Environment=NODE_ENV=production
# Слушаем только localhost: наружу порт публикует nginx, а не сам обработчик.
Environment=LEAD_HOST=127.0.0.1
Environment=LEAD_PORT=3000

Restart=always
RestartSec=3s

# Логи заявок идут в journald.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bars-lead

# Ограничения прав. Нужна запись во весь каталог репозитория: пересборка сайта
# после правок в CMS пишет в _site (и кэш eleventy-img). Резервный лог заявок
# лежит там же (logs/).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/www/tlkbars/repo

[Install]
WantedBy=multi-user.target
