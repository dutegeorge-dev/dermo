# Переменные внутреннего раздела /crm/. Скопируйте в crm/.env и заполните.
# Файл .env в git не попадает.

# Подключение к PostgreSQL.
DATABASE_URL=postgres://crm:ПАРОЛЬ@127.0.0.1:5432/crm

# Где слушает сервис. Наружу его публикует nginx (location /crm/).
CRM_HOST=127.0.0.1
CRM_PORT=3100

# Публичный адрес сайта: с него разрешены изменяющие запросы (проверка Origin).
CRM_ORIGIN=https://tlkbars.ru

# Каталог для вложений (файлы страниц базы знаний, позже — сделок).
# В проде — /var/lib/bars-crm/uploads (его создаёт systemd: StateDirectory).
CRM_UPLOAD_DIR=./uploads

# Максимальный размер одного вложения, МБ.
CRM_MAX_UPLOAD_MB=25
# Каталоги фабрик (раздел «Каталоги»): размер файла, МБ, и сколько разбирать одновременно.
# CRM_MAX_CATALOG_MB=400
# CRM_CATALOG_WORKERS=2

# Срок жизни сессии, дней.
CRM_SESSION_DAYS=30

# Cookie с флагом Secure. В проде — true (HTTPS). Для локальной разработки
# по http://localhost можно выключить: false.
CRM_COOKIE_SECURE=true

# Доверять X-Forwarded-For от nginx (IP клиента для лимита попыток входа).
CRM_TRUST_PROXY=true

# ── ИИ (Claude): разбор документов и чат ────────────────────────────────────
# Без ключа кнопки ИИ просто не показываются. Подходит прямой ключ Anthropic
# (ANTHROPIC_API_KEY) или шлюз: адрес + токен.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
# Модель. По умолчанию claude-haiku-5-5 — дешёвая, её хватает на разбор и чат.
# Opus (claude-opus-5-5) умнее, но примерно в 40 раз дороже.
CRM_AI_MODEL=

# ── Бот заявок в Telegram ───────────────────────────────────────────────────
# Сотрудник пересылает боту текст заявки — бот заводит лид в воронке (клиент, контакт, тип).
# Токен — у @BotFather (/newbot). Пусто — бот выключен. Привязка сотрудника: Профиль → «Привязать Telegram».
CRM_TELEGRAM_BOT_TOKEN=
# Если api.telegram.org с сервера недоступен — адрес своего прокси / сервера Bot API.
# CRM_TELEGRAM_API_URL=https://api.telegram.org

# Импорт уже разобранных заявок без входа: POST /crm/api/intake/leads, «Authorization: Bearer <токен>».
# Нужен, когда ИИ-шлюз лежит и заявки разбирает внешний помощник. Пусто (или короче 24 символов) — выключен.
# Сгенерировать: openssl rand -hex 24
CRM_INTAKE_TOKEN=

# ── Лидогенерация WB (раздел «Лидогенерация», воркер bars-crm-leadgen) ──────
# Реквизиты по ИНН: DaData findById/party (бесплатно до 10 000 запросов в сутки). Без токена сбор не запустится.
DADATA_TOKEN=
# Контакты по ИНН: Checko API v2 (платный ключ, передаётся параметром key). Пусто — только контакты с WB.
CHECKO_API_KEY=
# Прокси для запросов к WB, если у сервера не российский IP: http://user:pass@host:port. Пусто — напрямую.
WB_PROXY=
# Свой файл эндпоинтов WB поверх server/lib/leadgen/wb-endpoints.json (чинить без git): /etc/bars-crm/wb-endpoints.json
LEADGEN_WB_CONFIG=
# Воркер сбора внутри bars-crm (для разработки). В проде — отдельная служба bars-crm-leadgen.
# CRM_LEADGEN_INLINE=true

# ── Рассылка (раздел «Рассылка», воркер bars-crm-mail) ─────────────────────
# Ключ шифрования паролей ящиков (AES-256-GCM): openssl rand -hex 32. Сменили — пароли ящиков ввести заново.
MAILBOX_SECRET_KEY=
# Воркер рассылки внутри bars-crm (для разработки). В проде — отдельная служба bars-crm-mail.
# CRM_MAIL_INLINE=true
# Этапы 2–3: уведомления в Telegram, свой резолвер для Spamhaus DBL (не 8.8.8.8 / 1.1.1.1), SSH-ключ для логов переходов.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MAIL_DNS_RESOLVER=
LEADCLICKS_SSH_KEY=

# ── Расчёт таможенных платежей ──────────────────────────────────────────────
# Справочник ТН ВЭД со ставками (npm run tnved:update, cron раз в сутки) и курсы ЦБ.
# Обычно менять не нужно.
CRM_TNVED_URL=
CRM_CBR_URL=
# Фиксированные курсы вместо ЦБ (тесты, работа без интернета): {"USD":80,"EUR":90,"CNY":11}
CRM_RATES_FIXED=

# ── Бэкапы (crm/scripts/backup.sh, cron раз в сутки) ────────────────────────
# Локальная копия: каталог и срок хранения.
CRM_BACKUP_DIR=/var/backups/bars-crm
CRM_BACKUP_KEEP_DAYS=14
# Облако через rclone (см. crm/README.md → «Бэкапы в облако»). Пусто — только локально.
# Пример: зашифрованный remote поверх Яндекс Object Storage.
CRM_BACKUP_RCLONE_REMOTE=
CRM_BACKUP_CLOUD_KEEP_DAYS=30
# Если бэкап не удался — сообщение в Telegram (бот @BotFather, ID чата — @userinfobot).
CRM_BACKUP_TELEGRAM_TOKEN=
CRM_BACKUP_TELEGRAM_CHAT=
