# Переменные внутреннего раздела /crm/. Скопируйте в crm/.env и заполните.
# Файл .env в git не попадает.

# Подключение к PostgreSQL.
DATABASE_URL=postgres://crm:ПАРОЛЬ@127.0.0.1:5432/crm

# Где слушает сервис. Наружу его публикует nginx (location /crm/).
CRM_HOST=127.0.0.1
CRM_PORT=3100

# Публичный адрес сайта: с него разрешены изменяющие запросы (проверка Origin).
CRM_ORIGIN=https://tlkbars.ru

# Каталог для вложений (файлы страниц базы знаний, позже — сделок).
# В проде — /var/lib/bars-crm/uploads (его создаёт systemd: StateDirectory).
CRM_UPLOAD_DIR=./uploads

# Максимальный размер одного вложения, МБ.
CRM_MAX_UPLOAD_MB=25

# Срок жизни сессии, дней.
CRM_SESSION_DAYS=30

# Cookie с флагом Secure. В проде — true (HTTPS). Для локальной разработки
# по http://localhost можно выключить: false.
CRM_COOKIE_SECURE=true

# Доверять X-Forwarded-For от nginx (IP клиента для лимита попыток входа).
CRM_TRUST_PROXY=true
